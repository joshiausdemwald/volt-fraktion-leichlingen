---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  badge?: string;
  title: string;
  lead: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  backgroundImage?: string | ImageMetadata;
  backgroundPosition?: string;
}

const {
  badge,
  title,
  lead,
  primaryCtaText,
  primaryCtaHref,
  secondaryCtaText,
  secondaryCtaHref,
  backgroundImage,
  backgroundPosition = 'center',
} = Astro.props;

const optimizedBackgroundImage = typeof backgroundImage === 'string' || !backgroundImage
  ? undefined
  : await getImage({ src: backgroundImage, format: 'webp', width: 1920 });
const backgroundImageUrl = typeof backgroundImage === 'string'
  ? backgroundImage
  : optimizedBackgroundImage?.src;
const heroStyle = backgroundImageUrl
  ? `--hero-background-image: url("${backgroundImageUrl.replace(/"/g, '\\"')}"); --hero-background-position: ${backgroundPosition};`
  : undefined;
---

<section class:list={['hero-section', { 'has-background-image': backgroundImageUrl }]} style={heroStyle} aria-label={title}>
  <div class="container hero-container animate-fade-in">
    <div class="hero-content">
      {badge && <span class="hero-badge badge badge-accent">{badge}</span>}
      <h1 class="hero-title">{title}</h1>
      <p class="hero-lead">{lead}</p>
      
      {(primaryCtaText || secondaryCtaText) && (
        <div class="hero-cta">
          {primaryCtaText && primaryCtaHref && (
            <a href={primaryCtaHref} class="btn btn-primary">{primaryCtaText}</a>
          )}
          {secondaryCtaText && secondaryCtaHref && (
            <a href={secondaryCtaHref} class="btn btn-outline">{secondaryCtaText}</a>
          )}
        </div>
      )}
    </div>
    
    <div class="hero-graphic" aria-hidden="true">
      <div class="glass-card">
        <div class="glass-card-header">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
        </div>
        <div class="glass-card-body">
          <div class="stat-row">
            <span class="stat-number">100%</span>
            <span class="stat-label">Transparent</span>
          </div>
          <div class="stat-row">
            <span class="stat-number">15+</span>
            <span class="stat-label">Initiativen</span>
          </div>
          <div class="stat-row">
            <span class="stat-number">2035</span>
            <span class="stat-label">Klimaneutralität</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: 6rem;
    padding-bottom: 6rem;
    overflow: hidden;
    background: radial-gradient(circle at 80% 20%, hsl(var(--primary-hue), 70%, 95%) 0%, transparent 50%),
                radial-gradient(circle at 10% 80%, hsl(205, 80%, 96%) 0%, transparent 50%);
  }

  .hero-section.has-background-image {
    min-height: 620px;
    display: flex;
    align-items: center;
    background-image: linear-gradient(90deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.84) 44%, rgba(255, 255, 255, 0.18) 100%),
                      var(--hero-background-image);
    background-size: cover;
    background-position: var(--hero-background-position);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 4rem;
  }

  @media (max-width: 992px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 3rem;
    }
  }

  .hero-badge {
    margin-bottom: 1.5rem;
    /* Markanter Volt-Red Badge: deckend, weiße Schrift */
    background-color: var(--volt-red);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.5rem 1.1rem;
    letter-spacing: 0.08em;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, var(--text-primary) 30%, var(--primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 2.75rem;
    }
  }

  .hero-lead {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    max-width: 600px;
  }

  @media (max-width: 992px) {
    .hero-lead {
      margin-left: auto;
      margin-right: auto;
    }
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
  }

  @media (max-width: 992px) {
    .hero-cta {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .hero-cta {
      flex-direction: column;
    }
  }

  .hero-graphic {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 992px) {
    .hero-graphic {
      display: none;
    }
  }

  /* Solid stat card in hero (comic style) */
  .glass-card {
    background: #ffffff;
    width: 320px;
    padding: 1.75rem;
    box-shadow: var(--shadow-lg);
  }

  .glass-card-header {
    display: flex;
    gap: 6px;
    margin-bottom: 2rem;
  }

  .dot {
    width: 12px;
    height: 12px;
  }
  .dot.red { background-color: var(--volt-red); }
  .dot.yellow { background-color: var(--volt-yellow); }
  .dot.green { background-color: var(--volt-blue); }

  .stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
  }

  .stat-row:last-child {
    margin-bottom: 0;
    border-bottom: none;
    padding-bottom: 0;
  }

  .stat-number {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.75rem;
    color: var(--primary);
  }

  .stat-label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }
</style>
