---
interface Props {
  title?: string;
  showHours?: boolean;
}

const { title = "Fraktionsbüro", showHours = false } = Astro.props;
---

<div class="contact-card-box">
  <h3>{title}</h3>
  
  <address class="contact-address">
    Volt Fraktion Leichlingen<br />
    Bahnhofstraße 33<br />
    42799 Leichlingen
  </address>

  <div class="contact-methods">
    <div class="contact-method-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="method-icon"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
      <div>
        <span class="method-label">E-Mail:</span>
        <a href="mailto:leichlingen@voltdeutschland.org" class="method-link">leichlingen@voltdeutschland.org</a>
      </div>
    </div>

    <div class="contact-method-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="method-icon"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
      <div>
        <span class="method-label">Telefon:</span>
        <a href="tel:+4915902055715" class="method-link">+49 (0) 159 0205 5715</a>
      </div>
    </div>
  </div>

  {showHours && (
    <div class="hours-section">
      <h4 class="hours-title">Bürger:Innensprechstunde</h4>
      <p class="hours-sub">Kommen Sie gerne direkt vorbei, eine Anmeldung ist nicht erforderlich.</p>
      <ul class="hours-listing">
        <li><span>Mittwochs:</span> <span>17:00 – 18:00 Uhr</span></li>
        <li><span>Sowie nach Vereinbarung</span></li>
      </ul>
    </div>
  )}
</div>

<style>
  .contact-card-box {
    background-color: var(--bg-card);
    border-radius: var(--radius-md);
    padding: 2rem;
    box-shadow: var(--shadow-md);
  }

  .contact-card-box h3 {
    font-size: 1.5rem;
    margin-bottom: 1.25rem;
    color: var(--primary);
  }

  .contact-address {
    font-style: normal;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-method-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .method-icon {
    color: var(--primary);
    margin-top: 0.2rem;
    flex-shrink: 0;
  }

  .method-label {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--text-tertiary);
  }

  .method-link {
    font-weight: 700;
    color: var(--text-primary);
  }

  .method-link:hover {
    color: var(--primary);
  }

  /* Hours section */
  .hours-section {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
  }

  .hours-title {
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .hours-sub {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    margin-bottom: 1rem;
    line-height: 1.4;
  }

  .hours-listing {
    list-style: none;
    padding: 0;
  }

  .hours-listing li {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
    padding-bottom: 0.4rem;
  }

  .hours-listing li:last-child {
    padding-bottom: 0;
    margin-bottom: 0;
    font-style: italic;
    color: var(--text-tertiary);
  }
</style>
