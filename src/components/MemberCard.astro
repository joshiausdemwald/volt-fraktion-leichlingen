---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  role: string;
  email?: string;
  phone?: string;
  image?: ImageMetadata;
  committees: string[];
  slug: string;
}

const { name, role, email, phone, image, committees = [], slug } = Astro.props;

// Extract initials for placeholder
const initials = name
  .split(' ')
  .map((n) => n[0])
  .join('')
  .substring(0, 2);
---

<article class="member-card">
  <div class="member-avatar-container">
    {image ? (
      <Image src={image} alt={name} class="member-image" width={400} height={250} loading="lazy" />
    ) : (
      <div class="member-avatar-placeholder" aria-hidden="true">
        <span>{initials}</span>
      </div>
    )}
  </div>
  <div class="member-info">
    <h3 class="member-name"><a href={`/fraktion/${slug}`}>{name}</a></h3>
    <p class="member-role">{role}</p>
    
    {committees.length > 0 && (
      <div class="member-committees">
        <span class="committees-label">Ausschüsse:</span>
        <ul class="committees-list">
          {committees.slice(0, 2).map((comm) => (
            <li>{comm}</li>
          ))}
          {committees.length > 2 && <li class="more-committees">+{committees.length - 2} weitere</li>}
        </ul>
      </div>
    )}
    
    <div class="member-contact">
      {email && (
        <a href={`mailto:${email}`} class="contact-link" aria-label={`E-Mail an ${name}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          <span class="contact-text">{email}</span>
        </a>
      )}
      {phone && (
        <a href={`tel:${phone}`} class="contact-link" aria-label={`Telefonische Kontaktaufnahme mit ${name}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <span class="contact-text">{phone}</span>
        </a>
      )}
    </div>
    
    <a href={`/fraktion/${slug}`} class="btn btn-secondary btn-sm member-details-btn">
      Profil ansehen
    </a>
  </div>
</article>

<style>
  .member-card {
    background-color: var(--bg-card);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
    height: 100%;
  }

  .member-card:hover {
    transform: translate(4px, 4px);
    box-shadow: var(--shadow-sm);
  }

  .member-avatar-container {
    width: 100%;
    height: 250px;
    background-color: var(--bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .member-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .member-avatar-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, hsl(var(--primary-hue), 35%, 85%) 0%, hsl(var(--primary-hue), 25%, 70%) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .member-avatar-placeholder span {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 3rem;
    color: var(--primary);
    letter-spacing: 0.05em;
  }

  .member-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .member-name {
    font-size: 1.35rem;
    margin-bottom: 0.25rem;
  }

  .member-name a {
    color: var(--text-primary);
  }

  .member-name a:hover {
    color: var(--primary);
  }

  .member-role {
    font-size: 0.95rem;
    color: var(--text-tertiary);
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .member-committees {
    margin-bottom: 1.25rem;
    background-color: var(--bg-secondary);
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    flex-grow: 1;
  }

  .committees-label {
    font-weight: 700;
    display: block;
    margin-bottom: 0.25rem;
    color: var(--text-primary);
  }

  .committees-list {
    list-style: none;
    padding-left: 0;
  }

  .committees-list li {
    color: var(--text-secondary);
    margin-bottom: 0.2rem;
    position: relative;
    padding-left: 0.75rem;
  }

  .committees-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--primary);
  }

  .committees-list li.more-committees {
    font-style: italic;
    color: var(--text-tertiary);
  }

  .committees-list li.more-committees::before {
    content: "";
  }

  .member-contact {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding-top: 1rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    word-break: break-all;
  }

  .contact-link:hover {
    color: var(--primary);
  }

  .contact-link svg {
    flex-shrink: 0;
    color: var(--primary);
  }

  .member-details-btn {
    width: 100%;
    margin-top: auto;
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
  }
</style>
