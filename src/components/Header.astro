---
import { Image } from 'astro:assets';
import voltLogo from '../assets/volt-logo.png';

// Determine current path for active states
const pathname = new URL(Astro.request.url).pathname;
const cleanPath = pathname === '/' ? '/' : pathname.replace(/\/$/, '');

const navItems = [
	{ href: '/', label: 'Start' },
	{ href: '/aktuelles', label: 'Aktuelles' },
	{ href: '/themen', label: 'Themen' },
	{ href: '/antraege', label: 'Anträge' },
	{ href: '/fraktion', label: 'Fraktion' },
	{ href: '/kontakt', label: 'Kontakt' },
];
---

<header class="header">
  <div class="container header-container">
    <a href="/" class="logo-link" aria-label="Volt Fraktion Leichlingen Startseite">
      <div class="logo">
        <Image src={voltLogo} alt="Volt" class="logo-img" height={32} />
        <span class="logo-fraktion">Fraktion Leichlingen</span>
      </div>
    </a>
    
    <!-- Mobile Menu Toggle Button -->
    <button 
      type="button" 
      class="menu-toggle" 
      aria-expanded="false" 
      aria-controls="navigation" 
      aria-label="Hauptmenü öffnen/schließen"
      id="menu-btn"
    >
      <span class="hamburger"></span>
    </button>

    <!-- Navigation -->
    <nav id="navigation" class="nav">
      <ul class="nav-list">
        {navItems.map((item) => {
          const isActive = item.href === '/' 
            ? cleanPath === '/' 
            : cleanPath.startsWith(item.href);
          return (
            <li class="nav-item">
              <a 
                href={item.href} 
                class:list={['nav-link', { active: isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		background-color: #ffffff;
		box-shadow: 0 4px 0 var(--volt-purple);
		transition: background-color var(--transition-normal);
	}

	.header-container {
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: 4.5rem;
	}

	.logo-link {
		color: inherit;
	}

	.logo {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1.35rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.logo-img {
		height: 32px;
		width: auto;
		display: block;
	}

	.logo-fraktion {
		font-weight: 500;
		color: var(--text-primary);
		font-size: 1.15rem;
	}

	.nav-list {
		display: flex;
		list-style: none;
		gap: 1.5rem;
	}

	.nav-link {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1rem;
		color: var(--text-secondary);
		padding: 0.5rem 0.75rem;
		border-radius: var(--radius-sm);
		transition: all var(--transition-fast);
	}

	.nav-link:hover, .nav-link.active {
		color: var(--primary);
		background-color: var(--primary-light);
	}

	/* Hamburger Button for Mobile */
	.menu-toggle {
		display: none;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5rem;
		position: relative;
		width: 40px;
		height: 40px;
		z-index: 100;
	}

	.hamburger {
		display: block;
		width: 24px;
		height: 2px;
		background-color: var(--text-primary);
		position: absolute;
		left: 8px;
		top: 19px;
		transition: background var(--transition-fast);
	}

	.hamburger::before, .hamburger::after {
		content: "";
		display: block;
		width: 24px;
		height: 2px;
		background-color: var(--text-primary);
		position: absolute;
		left: 0;
		transition: transform var(--transition-fast);
	}

	.hamburger::before {
		top: -8px;
	}

	.hamburger::after {
		top: 8px;
	}

	.menu-toggle[aria-expanded="true"] .hamburger {
		background: transparent;
	}

	.menu-toggle[aria-expanded="true"] .hamburger::before {
		transform: rotate(45deg);
		top: 0;
	}

	.menu-toggle[aria-expanded="true"] .hamburger::after {
		transform: rotate(-45deg);
		top: 0;
	}

	/* Responsive Nav */
	@media (max-width: 768px) {
		.menu-toggle {
			display: block;
		}

		.nav {
			position: fixed;
			top: 4.5rem;
			left: 0;
			right: 0;
			bottom: 0;
			background-color: var(--bg-primary);
			padding: 2rem;
			transform: translateX(100%);
			transition: transform var(--transition-normal);
		}

		.nav-open {
			transform: translateX(0);
		}

		.nav-list {
			flex-direction: column;
			gap: 1.5rem;
			align-items: center;
		}

		.nav-link {
			font-size: 1.25rem;
			padding: 0.75rem 1.5rem;
			display: block;
			text-align: center;
		}
	}
</style>
