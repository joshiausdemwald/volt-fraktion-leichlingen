---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';


export async function getStaticPaths() {
  const memberEntries = await getCollection('members');
  return memberEntries.map(entry => ({
    params: { slug: entry.slug }, 
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Extract initials for fallback avatar
const initials = entry.data.name
  .split(' ')
  .map((n) => n[0])
  .join('')
  .substring(0, 2);
---

<Layout 
  title={`${entry.data.name} | Volt Fraktion Leichlingen`}
  description={`Erfahren Sie mehr über ${entry.data.name}, ${entry.data.role} in der Volt Fraktion Leichlingen.`}
>
  <div class="container section">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <span><a href="/">Startseite</a></span>
      <span><a href="/fraktion">Fraktion</a></span>
      <strong>{entry.data.name}</strong>
    </nav>

    <div class="member-detail-layout">
      <!-- Sidebar / Bio Photo and Contact Details -->
      <aside class="member-profile-card">
        <div class="member-image-wrapper">
          {entry.data.image ? (
            <Image src={entry.data.image} alt={entry.data.name} class="detail-image" />
          ) : (
            <div class="detail-avatar-placeholder">
              <span>{initials}</span>
            </div>
          )}
        </div>
        
        <div class="member-meta-info">
          <h1>{entry.data.name}</h1>
          <p class="role-badge">{entry.data.role}</p>

          <div class="contact-box">
            <h2 class="contact-title">Kontakt</h2>
            {entry.data.email && (
              <a href={`mailto:${entry.data.email}`} class="contact-btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                E-Mail schreiben
              </a>
            )}
            {entry.data.phone && (
              <a href={`tel:${entry.data.phone}`} class="contact-btn phone">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                {entry.data.phone}
              </a>
            )}
          </div>
        </div>
      </aside>

      <!-- Main Profile Bio & Committees -->
      <main class="member-content">
        <!-- Biography prose -->
        <section class="member-section" aria-labelledby="bio-heading">
          <h2 id="bio-heading" class="section-title">Biographie & Motivation</h2>
          <div class="prose">
            <Content />
          </div>
        </section>

        <!-- Committee membership details -->
        {entry.data.committees && entry.data.committees.length > 0 && (
          <section class="member-section mt-3" aria-labelledby="committees-heading">
            <h2 id="committees-heading" class="section-title">Ausschüsse & Gremien</h2>
            <p class="committees-desc">Vertretung der Volt Fraktion in folgenden städtischen Gremien:</p>
            <ul class="committees-detail-list">
              {entry.data.committees.map((comm) => (
                <li class="committee-detail-item">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="bullet-icon"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>{comm}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <div class="back-action">
          <a href="/fraktion" class="btn btn-secondary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="transform: rotate(180deg)"><path d="M5 12h14"></path><polyline points="12 5 19 12 12 19"></polyline></svg>
            Zurück zur Frakionsübersicht
          </a>
        </div>
      </main>
    </div>
  </div>
</Layout>

<style>
  .member-detail-layout {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 992px) {
    .member-detail-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  /* Left Side Profile Card */
  .member-profile-card {
    background-color: var(--bg-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .member-image-wrapper {
    width: 100%;
    height: 350px;
    background-color: var(--bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .detail-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .detail-avatar-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, hsl(var(--primary-hue), 35%, 85%) 0%, hsl(var(--primary-hue), 25%, 70%) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .detail-avatar-placeholder span {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 4rem;
    color: var(--primary);
  }

  .member-meta-info {
    padding: 2rem;
  }

  .member-meta-info h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .role-badge {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    color: var(--primary);
    margin-bottom: 2rem;
  }

  /* Contact Actions */
  .contact-box {
    padding-top: 1.5rem;
  }

  .contact-title {
    font-size: 1.15rem;
    margin-bottom: 1rem;
  }

  .contact-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.75rem 1rem;
    background-color: var(--primary);
    color: white;
    border-radius: var(--radius-md);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
    transition: all var(--transition-fast);
  }

  .contact-btn:hover {
    background-color: var(--primary-hover);
    color: white;
  }

  .contact-btn.phone {
    background-color: var(--primary-light);
    color: var(--primary);
  }

  .contact-btn.phone:hover {
    background-color: var(--primary-light-hover);
  }

  /* Right Side Content */
  .member-section {
    background-color: var(--bg-card);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 640px) {
    .member-section {
      padding: 1.5rem;
    }
  }

  .section-title {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    color: var(--primary);
    padding-bottom: 0.5rem;
  }

  .mt-3 {
    margin-top: 2rem;
  }

  .prose {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
  }

  .prose :global(h3) {
    font-size: 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .prose :global(ul) {
    margin-bottom: 1.25rem;
    padding-left: 1.25rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(blockquote) {
    background-color: var(--primary-light);
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--text-primary);
  }

  /* Committee styling */
  .committees-desc {
    font-size: 0.95rem;
    color: var(--text-tertiary);
    margin-bottom: 1rem;
  }

  .committees-detail-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }

  .committee-detail-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background-color: var(--bg-secondary);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .bullet-icon {
    color: var(--accent);
    flex-shrink: 0;
  }

  .back-action {
    margin-top: 2.5rem;
    display: flex;
    justify-content: flex-start;
  }
</style>
