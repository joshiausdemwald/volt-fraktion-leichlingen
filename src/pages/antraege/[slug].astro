---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import MotionStatus from '../../components/MotionStatus.astro';

export async function getStaticPaths() {
  const motionEntries = await getCollection('motions');
  return motionEntries.map(entry => ({
    params: { slug: entry.slug }, 
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const formattedDate = new Date(entry.data.date).toLocaleDateString('de-DE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout 
  title={`${entry.data.motionId}: ${entry.data.title} | Volt Fraktion Leichlingen`}
  description={entry.data.summary}
>
  <div class="container section">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <span><a href="/">Startseite</a></span>
      <span><a href="/antraege">Anträge</a></span>
      <strong>{entry.data.motionId}</strong>
    </nav>

    <div class="motion-detail-layout">
      <!-- Main Content -->
      <article class="motion-main">
        <header class="motion-detail-header">
          <div class="motion-meta-top">
            <span class="motion-id-badge">{entry.data.motionId}</span>
            <time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
          </div>
          <h1>{entry.data.title}</h1>
        </header>

        <div class="motion-body prose">
          <Content />
        </div>
      </article>

      <!-- Sidebar with Metadata -->
      <aside class="motion-sidebar">
        <div class="sidebar-card">
          <h2 class="sidebar-title">Antragsdetails</h2>
          
          <div class="meta-list">
            <div class="meta-item">
              <span class="meta-label">Status:</span>
              <div class="meta-value">
                <MotionStatus status={entry.data.status} />
              </div>
            </div>
            
            <div class="meta-item">
              <span class="meta-label">Aktenzeichen:</span>
              <span class="meta-value font-mono">{entry.data.motionId}</span>
            </div>

            <div class="meta-item">
              <span class="meta-label">Datum eingereicht:</span>
              <span class="meta-value">{formattedDate}</span>
            </div>

            {entry.data.documentUrl && entry.data.documentUrl !== '#' && (
              <div class="meta-item border-top mt-1">
                <span class="meta-label">Ratsdokument:</span>
                <span class="meta-value">
                  <a href={entry.data.documentUrl} class="btn btn-primary btn-sm font-sm w-100 mt-0-5" target="_blank" rel="noopener noreferrer">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.25rem;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                    Original-PDF
                  </a>
                </span>
              </div>
            )}
          </div>

          <div class="sidebar-info-banner">
            <h3>Ihre Meinung zählt!</h3>
            <p>Haben Sie Fragen oder Vorschläge zu dieser Initiative? Kontaktieren Sie unsere Fraktion direkt.</p>
            <a href="/kontakt" class="btn btn-outline btn-sm font-sm w-100">Feedback geben</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .motion-detail-layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 992px) {
    .motion-detail-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  .motion-detail-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
  }

  .motion-meta-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.9rem;
    color: var(--text-tertiary);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .motion-id-badge {
    background-color: var(--primary-light);
    color: var(--primary);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .motion-detail-header h1 {
    font-size: 2.5rem;
    line-height: 1.25;
    color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .motion-detail-header h1 {
      font-size: 1.85rem;
    }
  }

  /* Prose typography styling for markdown content */
  .prose {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
  }

  .prose :global(h3) {
    font-size: 1.35rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .prose :global(ul), .prose :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(strong) {
    color: var(--text-primary);
  }

  /* Sidebar Card */
  .sidebar-card {
    background-color: var(--bg-card);
    border-radius: var(--radius-md);
    padding: 2rem;
    box-shadow: var(--shadow-md);
    position: sticky;
    top: 6.5rem;
  }

  .sidebar-title {
    font-size: 1.35rem;
    margin-bottom: 1.5rem;
    color: var(--primary);
    padding-bottom: 0.5rem;
  }

  .meta-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-item.border-top {
    padding-top: 1.25rem;
  }

  .meta-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .meta-value {
    font-size: 1rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .font-mono {
    font-family: monospace;
    font-weight: 700;
  }

  .w-100 {
    width: 100%;
  }

  .mt-0-5 {
    margin-top: 0.5rem;
  }

  .sidebar-info-banner {
    background-color: var(--primary-light);
    padding: 1.25rem;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
  }

  .sidebar-info-banner h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    color: var(--primary);
  }

  .sidebar-info-banner p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    line-height: 1.4;
  }

  .font-sm {
    font-size: 0.85rem;
  }

  .btn-sm {
    padding: 0.5rem 1rem;
  }
</style>
