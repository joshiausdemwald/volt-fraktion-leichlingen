---
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const sortedNews = allNews.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout 
  title="Aktuelles & Pressemitteilungen | Volt Fraktion Leichlingen"
  description="Bleiben Sie informiert: Aktuelle Meldungen, Pressemitteilungen und Berichte aus dem Stadtrat Leichlingen von der Volt Fraktion."
>
  <div class="container section">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <span><a href="/">Startseite</a></span>
      <strong>Aktuelles</strong>
    </nav>

    <!-- Page Header -->
    <header class="page-header">
      <span class="badge badge-primary">Presseportal</span>
      <h1>Aktuelles & Pressemitteilungen</h1>
      <p class="lead">
        Hier finden Sie alle Berichte über unsere politische Arbeit im Stadtrat sowie aktuelle Pressemitteilungen der Volt Fraktion Leichlingen.
      </p>
    </header>

    {sortedNews.length > 0 ? (
      <div class="news-archive-grid">
        {sortedNews.map((post) => (
          <NewsCard 
            title={post.data.title} 
            date={post.data.date} 
            summary={post.data.summary} 
            slug={post.slug} 
            image={post.data.image}
            tags={post.data.tags}
          />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>Derzeit sind keine Artikel vorhanden. Schauen Sie bald wieder vorbei!</p>
      </div>
    )}
  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: 4rem;
    max-width: 800px;
  }

  .page-header h1 {
    font-size: 3rem;
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .lead {
    font-size: 1.2rem;
    color: var(--text-secondary);
  }

  .news-archive-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2.5rem;
  }

  @media (max-width: 480px) {
    .news-archive-grid {
      grid-template-columns: 1fr;
    }
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background-color: var(--bg-secondary);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
  }
</style>
