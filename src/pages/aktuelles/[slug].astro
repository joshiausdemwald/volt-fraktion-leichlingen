---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const newsEntries = await getCollection('news');
  return newsEntries.map(entry => ({
    params: { slug: entry.slug }, 
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const formattedDate = new Date(entry.data.date).toLocaleDateString('de-DE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout 
  title={`${entry.data.title} | Volt Fraktion Leichlingen`}
  description={entry.data.summary}
  image={entry.data.image?.src}
>
  <div class="container section">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <span><a href="/">Startseite</a></span>
      <span><a href="/aktuelles">Aktuelles</a></span>
      <strong>{entry.data.title}</strong>
    </nav>

    <article class="post-detail">
      <!-- Header -->
      <header class="post-header">
        <div class="post-meta">
          <time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
          <span class="meta-separator">•</span>
          <span class="read-time">Pressemitteilung</span>
        </div>
        <h1 class="post-title">{entry.data.title}</h1>
        
        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="post-tags">
            {entry.data.tags.map((tag) => (
              <span class="post-tag">#{tag}</span>
            ))}
          </div>
        )}
      </header>

      <!-- Featured Image -->
      {entry.data.image && (
        <div class="post-image-container">
          <Image src={entry.data.image} alt={entry.data.title} class="post-image" width={1200} height={675} />
        </div>
      )}

      <!-- Prose Content -->
      <div class="post-content prose">
        <Content />
      </div>

      <!-- Footer action -->
      <footer class="post-footer">
        <a href="/aktuelles" class="btn btn-secondary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transform: rotate(180deg)"><path d="M5 12h14"></path><polyline points="12 5 19 12 12 19"></polyline></svg>
          Zurück zur Übersicht
        </a>
      </footer>
    </article>
  </div>
</Layout>

<style>
  .post-detail {
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .post-header {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .post-meta {
    font-size: 0.9rem;
    color: var(--text-tertiary);
    font-weight: 700;
    margin-bottom: 0.75rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
  }

  .post-title {
    font-size: 2.75rem;
    line-height: 1.2;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 640px) {
    .post-title {
      font-size: 2rem;
    }
  }

  .post-tags {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-tag {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--primary);
    background-color: var(--primary-light);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
  }

  .post-image-container {
    margin-bottom: 3rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .post-image {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
  }

  .post-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    display: flex;
    justify-content: center;
  }

  /* Prose typography styling for markdown content */
  .prose {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .prose :global(p) {
    margin-bottom: 1.5rem;
  }

  .prose :global(h2) {
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
  }

  .prose :global(h3) {
    font-size: 1.35rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .prose :global(ul), .prose :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(blockquote) {
    padding: 1rem 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: var(--text-primary);
    background-color: var(--bg-secondary);
  }

  .prose :global(strong) {
    color: var(--text-primary);
    font-weight: 700;
  }
</style>
